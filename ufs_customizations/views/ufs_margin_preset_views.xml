<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_ufs_margin_preset_list" model="ir.ui.view">
        <field name="name">ufs.margin.preset.list</field>
        <field name="model">ufs.margin.preset</field>
        <field name="arch" type="xml">
            <list string="Margin Presets" editable="bottom">
                <field name="margin_pct"/>
                <field name="name"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_ufs_margin_preset_form" model="ir.ui.view">
        <field name="name">ufs.margin.preset.form</field>
        <field name="model">ufs.margin.preset</field>
        <field name="arch" type="xml">
            <form string="Margin Preset">
                <sheet>
                    <group>
                        <field name="margin_pct"/>
                        <field name="name"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_ufs_margin_preset" model="ir.actions.act_window">
        <field name="name">Margin Presets</field>
        <field name="res_model">ufs.margin.preset</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a margin preset.</p>
            <p>
                Presets show up as a dropdown on sale order lines and
                purchase order lines. Picking one sets the line price to
                <code>cost ÷ (1 − margin/100)</code>.
            </p>
        </field>
    </record>

    <menuitem id="menu_ufs_margin_preset_sales"
              name="Margin Presets"
              parent="sale.menu_sale_config"
              action="action_ufs_margin_preset"
              sequence="50"
              groups="sales_team.group_sale_manager"/>

    <menuitem id="menu_ufs_margin_preset_purchase"
              name="Margin Presets"
              parent="purchase.menu_purchase_config"
              action="action_ufs_margin_preset"
              sequence="50"
              groups="purchase.group_purchase_manager"/>
</odoo>
