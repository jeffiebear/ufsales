<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <record id="res_config_settings_view_form_ufs_customizations" model="ir.ui.view">
    <field name="name">res.config.settings.form.ufs.customizations</field>
    <field name="model">res.config.settings</field>
    <field name="inherit_id" ref="base.res_config_settings_view_form"/>
    <field name="arch" type="xml">
      <xpath expr="//form" position="inside">
        <app data-string="UFS Sales" string="UFS Sales" name="ufs_customizations"
             groups="sales_team.group_sale_manager">
          <block title="Auto-Invoice" id="ufs_auto_invoice_block">
            <setting id="ufs_auto_invoice_setting"
                     string="Auto-invoice on Delivery"
                     help="Validating an outgoing delivery creates, posts, and emails the invoice for the delivered quantities (net-terms customers only; credit-card / no-terms customers are skipped). Backorders invoice on later validation.">
              <field name="ufs_auto_invoice_on_delivery"/>
            </setting>
          </block>
          <block title="Purchasing" id="ufs_purchasing_block">
            <setting id="ufs_consolidate_pos_setting"
                     string="Consolidate Draft POs Daily"
                     help="Nightly merge of same-vendor draft purchase orders into one each, so backordered items stop creating a separate PO per item. Lines move intact; procurement links preserved. Also available on demand from the PO list Action menu.">
              <field name="ufs_consolidate_draft_pos"/>
            </setting>
          </block>
        </app>
      </xpath>
    </field>
  </record>
</odoo>
