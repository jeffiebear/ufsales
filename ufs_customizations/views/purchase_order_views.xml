<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Add the margin-preset dropdown to the PO line list. Renders
        right after price_unit so the workflow is: enter vendor cost,
        pick margin tier, catalog sell price is rewritten automatically.
    -->
    <record id="view_purchase_order_form_ufs_margin_preset" model="ir.ui.view">
        <field name="name">purchase.order.form.ufs.margin.preset</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/list/field[@name='price_unit']" position="after">
                <field name="ufs_margin_preset_id"
                       optional="show"
                       groups="purchase.group_purchase_user"
                       options="{'no_create': True, 'no_open': True}"/>
            </xpath>
        </field>
    </record>

    <!--
        Surface the real PO order date as a plain, always-visible column.

        The imported STEP1 history stores the true order date in
        `date_order` (spanning 2009-2026 and correct). The standard list
        renders `date_order` under the "Order Deadline" label with the
        `remaining_days` widget, which only prints a value for open RFQs
        and shows blank for every confirmed PO — so the historical dates
        look "missing" even though they are stored. We drop the widget
        and relabel the column so the actual date prints for every row.

        Targets the base list view; the RFQ ("Requests for Quotation")
        KPI list inherits it, so the column shows in both places. If a
        future Odoo build moves the base view id, adjust `inherit_id`.
    -->
    <record id="purchase_order_tree_ufs_order_date" model="ir.ui.view">
        <field name="name">purchase.order.list.ufs.order.date</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='date_order']" position="attributes">
                <attribute name="widget"/>
                <attribute name="string">Order Date</attribute>
                <attribute name="optional">show</attribute>
            </xpath>
        </field>
    </record>
</odoo>
