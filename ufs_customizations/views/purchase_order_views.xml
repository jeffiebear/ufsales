<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Add the margin-preset dropdown to the PO line list. Renders
        right after price_unit so the workflow is: enter vendor cost,
        pick margin tier, catalog sell price is rewritten automatically.
    -->
    <record id="view_purchase_order_form_ufs_margin_preset" model="ir.ui.view">
        <field name="name">purchase.order.form.ufs.margin.preset</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/list/field[@name='price_unit']" position="after">
                <field name="ufs_margin_preset_id"
                       optional="show"
                       groups="purchase.group_purchase_user"
                       options="{'no_create': True, 'no_open': True}"/>
            </xpath>
        </field>
    </record>

    <!--
        Surface the real PO order date on the "Purchase Orders" list.

        That list (this base view) shows Confirmation Date and Expected
        Arrival but has no order-date column, so the imported STEP1 order
        date (date_order, spanning 2009-2026 and already correct) is not
        visible. We ADD date_order as a plain "Order Date" column right
        after the Reference. It is added, not modified, because date_order
        is not already present in this view.

        Anchored on the "name" (Reference) field, which every purchase
        list view carries, so the xpath is stable.
    -->
    <record id="purchase_order_tree_ufs_order_date" model="ir.ui.view">
        <field name="name">purchase.order.list.ufs.order.date</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="date_order" string="Order Date" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>
