<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Customer invoice layout for #9 window envelopes.

        THE PROBLEM
        ===========
        Stock Odoo feeds two blocks into web.address_layout: the Shipping
        Address (information_block, left, col-6) and the billing address
        (address, right, col-5 ms-auto). That lands them at roughly 0.37" and
        4.87" from the left edge, running 2.49" to 3.43" down the page.

        A standard #9 window (1-1/8" x 4-1/2", set 7/8" from the left edge and
        1/2" up from the bottom) exposes the band 2" to 3-1/8" down the page
        and 0.7" to 5.2" across, once the sheet is folded in thirds. The stock
        layout straddles that band, so the window frames the tail of the
        shipping block on the left and the first third of an inch of the
        billing block on the right. Fragments of two addresses, never one.

        THE FIX
        ===========
        Feed our own markup into the existing "address" slot rather than
        blanking it and drawing elsewhere.

        This matters. The invoice heading is not part of the body: it is a
        t-set (layout_document_title) that the external layout renders just
        below the address area. Emptying "address" collapses that area, the
        heading slides up into the window band, and an absolutely positioned
        block then prints straight through it. Keeping the slot occupied keeps
        the rest of the document exactly where it was.

        web.address_layout gives us the hook we need:

            <div name="address" t-att-class="not custom_layout_address
                 and colclass or information_block and colclass">

        Setting custom_layout_address with no information_block resolves that
        class to nothing, dropping the col-5/ms-auto that would otherwise pin
        the block to the right-hand column. We get a full-width, left-aligned
        slot and size it to the window ourselves.

        The billing address is rebuilt from fields rather than reusing the
        contact widget: the widget emits country and the stock template
        appends Tax ID, which pushed a real invoice to seven rendered lines. A
        1-1/8" window fits about six. Name, street, street2 and city/state/zip
        is five at worst.

        GEOMETRY
        ===========
        Offsets are in the flow, not absolute, so nothing can collide with the
        heading. The address slot naturally begins about 2.49" down; the
        negative top margin lifts it to about 2.1", inside the window band.
        The body's left edge already sits about 0.36" in from the page edge,
        so the left margin below puts text about 0.95" across, comfortably
        inside the window's 0.7" to 5.2" span.

        The two blocks sit side by side. The mailing address occupies the
        window; the shipping address floats to its right, far enough across
        that it clears the window's right edge entirely. The fixed height on
        the mailing block reserves the band and clips anything unusually long
        rather than letting it spill past the window.
    -->
    <template id="report_invoice_document_ufs_win9"
              inherit_id="account.report_invoice_document">

        <!--
            Anchor on the invoice body wrapper: the one element here that is
            unique and not repeated across the three shipping-address
            branches, so the xpath holds whichever branch an invoice takes.
            Assignments land after those branches, so ours are the ones that
            reach web.address_layout.
        -->
        <xpath expr="//div[hasclass('invoice_main')]" position="before">

            <!-- ==== calibration knobs, millimetres ==== -->
            <!-- Measured: 10mm left the block at 2.47", too low. 20mm puts it ~2.07". -->
            <t t-set="ufs_win9_lift" t-value="20"/>
            <!-- Body edge is ~0.36" (9mm) in; +15mm puts text ~0.95" across. -->
            <t t-set="ufs_win9_left" t-value="15"/>
            <!-- Ends at ~4.88" on the page, inside the window's 5.2" right edge. -->
            <t t-set="ufs_win9_width" t-value="100"/>
            <!-- Reserves the band. 6 lines at 1.15 leading is ~1.02", so it fits. -->
            <t t-set="ufs_win9_height" t-value="28"/>
            <!--
                THE CONSTRAINT THAT MATTERS. The window's right edge is 5.2"
                from the page edge, which is 123mm from the body's left edge.
                Billing ends at 115mm (15 + 100), so this gap must carry the
                shipping block past 123mm or it reappears in the window and we
                are back to the original two-addresses-through-one-window bug.
                13mm starts it at 128mm, about 5.4" on the page.
            -->
            <t t-set="ufs_win9_ship_gap" t-value="13"/>
            <!-- Body is ~197mm wide, so 128 + 65 stays on the page. -->
            <t t-set="ufs_win9_ship_width" t-value="65"/>

            <!-- Only the mailing address belongs in the window. -->
            <t t-set="information_block" t-value="''"/>
            <!-- Drops the col-5/ms-auto so the slot is full width and left. -->
            <t t-set="custom_layout_address" t-value="True"/>

            <t t-set="address">
              <div name="ufs_win9_row"
                   t-attf-style="margin-top:-{{ ufs_win9_lift }}mm;
                                 min-height:{{ ufs_win9_height }}mm;">
                <div name="ufs_win9_address"
                     t-attf-style="float:left;
                                   margin-left:{{ ufs_win9_left }}mm;
                                   width:{{ ufs_win9_width }}mm;
                                   height:{{ ufs_win9_height }}mm;
                                   overflow:hidden;
                                   line-height:1.15;">
                    <div t-out="o.partner_id.commercial_company_name or o.partner_id.name"/>
                    <div t-if="o.partner_id.parent_id and o.partner_id.name and o.partner_id.name != (o.partner_id.commercial_company_name or '')"
                         t-out="o.partner_id.name"/>
                    <div t-if="o.partner_id.street" t-out="o.partner_id.street"/>
                    <div t-if="o.partner_id.street2" t-out="o.partner_id.street2"/>
                    <div>
                        <span t-if="o.partner_id.city" t-out="o.partner_id.city"/>
                        <span t-if="o.partner_id.state_id" t-out="o.partner_id.state_id.code"/>
                        <span t-if="o.partner_id.zip" t-out="o.partner_id.zip"/>
                    </div>
                </div>

                <!--
                    Shipping address, sitting to the RIGHT of the mailing
                    address rather than below it, so it reclaims the vertical
                    space and reads like the original two-column layout. The
                    left margin is what keeps it clear of the window's right
                    edge; see ufs_win9_ship_gap above before changing it.

                    Same group gate as stock, so databases not using separate
                    delivery addresses are unaffected.
                -->
                <div name="ufs_win9_shipping"
                     t-if="o.partner_shipping_id and o.partner_shipping_id != o.partner_id"
                     groups="account.group_delivery_invoice_address"
                     t-attf-style="float:left;
                                   margin-left:{{ ufs_win9_ship_gap }}mm;
                                   width:{{ ufs_win9_ship_width }}mm;
                                   line-height:1.15;">
                    <strong class="d-block">Shipping Address</strong>
                    <div t-field="o.partner_shipping_id"
                         t-options='{"widget": "contact", "fields": ["address", "name"], "no_marker": True}'/>
                </div>

                <!-- Floats are cleared so the invoice heading below is unaffected. -->
                <div style="clear:both;"/>
              </div>
            </t>

        </xpath>
    </template>
</odoo>
