<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="auth_signup_signup_wholesale_fields" inherit_id="auth_signup.signup" name="UFS Wholesale Signup Fields">
        <xpath expr="//form[contains(@class, 'oe_signup_form')]" position="attributes">
            <attribute name="enctype">multipart/form-data</attribute>
        </xpath>

        <xpath expr="//div[contains(@class, 'field-login')]" position="after">
            <div class="mb-3">
                <label for="company_name" class="form-label">Company Name</label>
                <input type="text" name="company_name" id="company_name" class="form-control" required="required" t-att-value="company_name"/>
            </div>
            <div class="mb-3">
                <label for="street" class="form-label">Street Address</label>
                <input type="text" name="street" id="street" class="form-control" required="required" t-att-value="street"/>
            </div>
            <div class="mb-3">
                <label for="street2" class="form-label">Address Line 2</label>
                <input type="text" name="street2" id="street2" class="form-control" t-att-value="street2"/>
            </div>
            <div class="row g-2">
                <div class="col-md-4 mb-3">
                    <label for="city" class="form-label">City</label>
                    <input type="text" name="city" id="city" class="form-control" required="required" t-att-value="city"/>
                </div>
                <div class="col-md-4 mb-3">
                    <label for="state_name" class="form-label">State / Region</label>
                    <input type="text" name="state_name" id="state_name" class="form-control" required="required" t-att-value="state_name"/>
                </div>
                <div class="col-md-4 mb-3">
                    <label for="zip" class="form-label">ZIP / Postal Code</label>
                    <input type="text" name="zip" id="zip" class="form-control" required="required" t-att-value="zip"/>
                </div>
            </div>
            <div class="mb-3">
                <label for="country_name" class="form-label">Country</label>
                <input type="text" name="country_name" id="country_name" class="form-control" required="required" t-att-value="country_name"/>
            </div>
            <div class="mb-3">
                <label for="phone" class="form-label">Phone</label>
                <input type="text" name="phone" id="phone" class="form-control" t-att-value="phone"/>
            </div>
            <div class="mb-3">
                <label for="fein_taxid" class="form-label">FEIN / Tax ID</label>
                <input type="text" name="fein_taxid" id="fein_taxid" class="form-control" required="required" t-att-value="fein_taxid"/>
            </div>
            <div class="mb-3">
                <label for="resale_certificate" class="form-label">Tax Resale Certificate</label>
                <input type="file" name="resale_certificate" id="resale_certificate" class="form-control" required="required" accept=".pdf,.png,.jpg,.jpeg,.webp"/>
                <div class="form-text">Accepted file types: PDF, PNG, JPG, JPEG, WEBP (max 10 MB).</div>
            </div>
        </xpath>
    </template>

    <template id="signup_pending" name="UFS Wholesale Signup Pending">
        <t t-call="web.login_layout">
            <div class="alert alert-success" role="status">
                Thank you. Your wholesale registration was submitted successfully.
            </div>
            <p>We received your details and resale certificate, and will review your application shortly.</p>
            <p>You will receive a welcome email as soon as your account is approved.</p>
            <div class="d-grid mt-3">
                <a href="/web/login" class="btn btn-primary">Back to Login</a>
            </div>
        </t>
    </template>
</odoo>

