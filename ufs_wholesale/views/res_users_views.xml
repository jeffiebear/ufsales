<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_users_search_wholesale_applications" model="ir.ui.view">
        <field name="name">res.users.search.wholesale.applications</field>
        <field name="model">res.users</field>
        <field name="arch" type="xml">
            <search string="Wholesale Applications">
                <field name="name"/>
                <field name="login"/>
                <filter name="pending" string="Pending" domain="[('partner_id.ufs_wholesale_state', '=', 'pending')]"/>
                <filter name="approved" string="Approved" domain="[('partner_id.ufs_wholesale_state', '=', 'approved')]"/>
                <filter name="rejected" string="Rejected" domain="[('partner_id.ufs_wholesale_state', '=', 'rejected')]"/>
            </search>
        </field>
    </record>

    <record id="view_users_list_wholesale_applications" model="ir.ui.view">
        <field name="name">res.users.list.wholesale.applications</field>
        <field name="model">res.users</field>
        <field name="arch" type="xml">
            <list string="Wholesale Applications" create="false" delete="false">
                <field name="name"/>
                <field name="login"/>
                <field name="ufs_company_name"/>
                <field name="ufs_fein_taxid"/>
                <field name="ufs_wholesale_state"/>
                <field name="create_date"/>
            </list>
        </field>
    </record>

    <record id="action_wholesale_applications" model="ir.actions.act_window">
        <field name="name">Wholesale Applications</field>
        <field name="res_model">res.users</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('share', '=', True)]</field>
        <field name="search_view_id" ref="ufs_wholesale.view_users_search_wholesale_applications"/>
        <field name="context">{'search_default_pending': 1}</field>
    </record>

    <menuitem id="menu_ufs_wholesale_root"
              name="Wholesale"
              parent="website.menu_website_global_configuration"
              sequence="90"
              groups="base.group_system"/>

    <menuitem id="menu_ufs_wholesale_applications"
              name="Applications"
              parent="ufs_wholesale.menu_ufs_wholesale_root"
              action="ufs_wholesale.action_wholesale_applications"
              sequence="10"
              groups="base.group_system"/>

    <record id="view_users_form_wholesale_fields" model="ir.ui.view">
        <field name="name">res.users.form.wholesale.fields</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_ufs_wholesale_approve"
                        type="object"
                        string="Approve Wholesale"
                        class="btn-primary"
                        invisible="share == False or ufs_wholesale_state == 'approved'"/>
                <button name="action_ufs_wholesale_reject"
                        type="object"
                        string="Reject Wholesale"
                        class="btn-secondary"
                        invisible="share == False or ufs_wholesale_state == 'rejected'"/>
            </xpath>

            <xpath expr="//notebook" position="inside">
                <page string="Wholesale" name="ufs_wholesale">
                    <group>
                        <group>
                            <field name="ufs_wholesale_state"/>
                            <field name="ufs_can_wholesale_shop" readonly="1"/>
                            <field name="ufs_company_name"/>
                            <field name="ufs_fein_taxid"/>
                        </group>
                        <group>
                            <field name="ufs_state_text"/>
                            <field name="ufs_country_text"/>
                            <field name="ufs_wholesale_approved_by_id" readonly="1"/>
                            <field name="ufs_wholesale_approved_on" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="ufs_resale_certificate_filename" invisible="1"/>
                        <field name="ufs_resale_certificate" filename="ufs_resale_certificate_filename"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>

