<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">
        <record id="mail_template_wholesale_signup_ack" model="mail.template">
            <field name="name">UFS Wholesale - Registration Received</field>
            <field name="model_id" ref="base.model_res_users"/>
            <field name="subject">We received your UFS Wholesale application</field>
            <field name="email_from">{{ (object.company_id.email_formatted or user.email_formatted or 'noreply@example.com') }}</field>
            <field name="email_to">{{ object.email or object.login }}</field>
            <field name="auto_delete" eval="True"/>
            <field name="body_html" type="html">
                <div>
                    <p>Hello <t t-out="object.name or 'there'"/>,</p>
                    <p>Thank you for registering with UFS Wholesale.</p>
                    <p>We received your company and resale certificate details and our team will review your application shortly.</p>
                    <p>You will receive another email as soon as your account is approved.</p>
                    <p>Thank you,<br/>UFS Sales</p>
                </div>
            </field>
        </record>

        <record id="mail_template_wholesale_welcome" model="mail.template">
            <field name="name">UFS Wholesale - Approval Welcome</field>
            <field name="model_id" ref="base.model_res_users"/>
            <field name="subject">Welcome to UFS Wholesale</field>
            <field name="email_from">{{ (object.company_id.email_formatted or user.email_formatted or 'noreply@example.com') }}</field>
            <field name="email_to">{{ object.email or object.login }}</field>
            <field name="auto_delete" eval="True"/>
            <field name="body_html" type="html">
                <div>
                    <p>Hello <t t-out="object.name or 'there'"/>,</p>
                    <p>Your wholesale account has been approved and is now active.</p>
                    <p>You can sign in and place wholesale orders at any time:</p>
                    <p><a href="/web/login">Sign in</a></p>
                    <p>Thank you,<br/>UFS Sales</p>
                </div>
            </field>
        </record>
    </data>
</odoo>
