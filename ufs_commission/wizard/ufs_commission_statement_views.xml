<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_ufs_commission_statement_form" model="ir.ui.view">
        <field name="name">ufs.commission.statement.form</field>
        <field name="model">ufs.commission.statement</field>
        <field name="arch" type="xml">
            <form string="Commission Statement">
                <group>
                    <group>
                        <field name="employee_id" options="{'no_create': True}"/>
                        <field name="period" widget="radio"/>
                    </group>
                    <group>
                        <field name="date_from" readonly="period != 'custom'" force_save="1"/>
                        <field name="date_to" readonly="period != 'custom'" force_save="1"/>
                        <field name="company_id" invisible="1"/>
                    </group>
                </group>
                <footer>
                    <button name="action_print" string="Print Statement" type="object" class="btn-primary"/>
                    <button name="action_view_orders" string="View Orders" type="object"/>
                    <button string="Close" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_ufs_commission_statement" model="ir.actions.act_window">
        <field name="name">Commission Statement</field>
        <field name="res_model">ufs.commission.statement</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
