<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_ufs_price_rule_import_form" model="ir.ui.view">
        <field name="name">ufs.price.rule.import.form</field>
        <field name="model">ufs.price.rule.import</field>
        <field name="arch" type="xml">
            <form string="Import STEP1 Customer Price Rules">
                <sheet>
                    <group invisible="state == 'done'">
                        <field name="csv_file" filename="csv_filename"/>
                        <field name="csv_filename" invisible="1"/>
                        <field name="create_missing_customers"/>
                        <field name="create_missing_products"/>
                        <field name="delete_existing"/>
                    </group>
                    <group invisible="state != 'done'">
                        <field name="log" widget="text" readonly="1" nolabel="1"/>
                    </group>
                    <field name="state" invisible="1"/>
                </sheet>
                <footer>
                    <button name="action_import" type="object"
                            string="Import" class="btn-primary"
                            invisible="state == 'done'"/>
                    <button string="Close" class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_ufs_price_rule_import" model="ir.actions.act_window">
        <field name="name">Import from STEP1</field>
        <field name="res_model">ufs.price.rule.import</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
