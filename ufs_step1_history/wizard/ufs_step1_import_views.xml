<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_ufs_step1_import_form" model="ir.ui.view">
        <field name="name">ufs.step1.import.form</field>
        <field name="model">ufs.step1.import</field>
        <field name="arch" type="xml">
            <form string="Load Step1 Invoice History">
                <p>Upload one normalized header file (one fiscal year at a time). Documents already in the archive are skipped, so re-uploading a file is safe.</p>
                <group>
                    <field name="file" filename="filename"/>
                    <field name="filename" invisible="1"/>
                    <field name="result" invisible="not result"/>
                </group>
                <footer>
                    <button name="action_load" string="Load" type="object" class="btn-primary"/>
                    <button string="Close" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_ufs_step1_import" model="ir.actions.act_window">
        <field name="name">Load Step1 Invoice History</field>
        <field name="res_model">ufs.step1.import</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- Accounting > Configuration > Step1 History: Load -->
    <menuitem id="menu_ufs_step1_import" name="Load Step1 Invoice History"
              parent="account.account_management_menu" action="action_ufs_step1_import" sequence="90"
              groups="account.group_account_manager"/>

</odoo>
