<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_partner_form_ufs_step1_history" model="ir.ui.view">
        <field name="name">res.partner.form.ufs.step1.history</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_view_ufs_step1_invoices" type="object" class="oe_stat_button" icon="fa-history"
                        invisible="ufs_step1_invoice_count == 0" groups="account.group_account_invoice">
                    <field name="ufs_step1_invoice_count" widget="statinfo" string="Step1 History"/>
                </button>
            </div>
        </field>
    </record>

</odoo>
