<?xml version="1.0" encoding="UTF-8"?>
<odoo noupdate="1">
  <!--
    Dedicated activity types so the two alert kinds are visible
    separately in the Activities views. Both use a warning icon and
    a tight 1- to 2-day deadline by default.
  -->

  <record id="mail_activity_data_margin_alert" model="mail.activity.type">
    <field name="name">UFS Margin Alert</field>
    <field name="summary">Fixed-price line below margin threshold</field>
    <field name="icon">fa-warning</field>
    <field name="delay_count">1</field>
    <field name="delay_unit">days</field>
    <field name="res_model">sale.order</field>
  </record>

  <record id="mail_activity_data_inventory_alert" model="mail.activity.type">
    <field name="name">UFS Inventory Alert</field>
    <field name="summary">On-hand at or below reorder threshold</field>
    <field name="icon">fa-cube</field>
    <field name="delay_count">2</field>
    <field name="delay_unit">days</field>
    <field name="res_model">product.template</field>
  </record>
</odoo>
