<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        "Print to Konica" header buttons. Each opens the print wizard,
        which picks up the active record from context and renders the
        right standard report. type="action" passes active_model /
        active_id automatically.
    -->

    <!-- Sale order -->
    <record id="view_order_form_ufs_print" model="ir.ui.view">
        <field name="name">sale.order.form.ufs.print</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="%(action_ufs_print_wizard)d"
                        type="action"
                        string="Print to Konica"
                        class="btn-secondary"
                        groups="sales_team.group_sale_salesman"/>
            </xpath>
        </field>
    </record>

    <!-- Customer invoice / credit note -->
    <record id="view_move_form_ufs_print" model="ir.ui.view">
        <field name="name">account.move.form.ufs.print</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="%(action_ufs_print_wizard)d"
                        type="action"
                        string="Print to Konica"
                        class="btn-secondary"
                        invisible="move_type not in ('out_invoice', 'out_refund')"
                        groups="account.group_account_invoice"/>
            </xpath>
        </field>
    </record>

    <!-- Delivery / picking -->
    <record id="view_picking_form_ufs_print" model="ir.ui.view">
        <field name="name">stock.picking.form.ufs.print</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="%(action_ufs_print_wizard)d"
                        type="action"
                        string="Print to Konica"
                        class="btn-secondary"
                        groups="stock.group_stock_user"/>
            </xpath>
        </field>
    </record>

    <!-- Purchase order -->
    <record id="view_purchase_order_form_ufs_print" model="ir.ui.view">
        <field name="name">purchase.order.form.ufs.print</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="%(action_ufs_print_wizard)d"
                        type="action"
                        string="Print to Konica"
                        class="btn-secondary"
                        groups="purchase.group_purchase_user"/>
            </xpath>
        </field>
    </record>
</odoo>
