<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ufs_print_wizard_form" model="ir.ui.view">
        <field name="name">ufs.print.wizard.form</field>
        <field name="model">ufs.print.wizard</field>
        <field name="arch" type="xml">
            <form string="Print to Konica">
                <group>
                    <field name="doc_model" invisible="1"/>
                    <field name="doc_id" invisible="1"/>
                    <field name="doc_name" readonly="1"/>
                    <field name="copies"/>
                    <field name="double_sided"/>
                </group>
                <footer>
                    <button name="action_print" type="object"
                            string="Print" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_ufs_print_wizard" model="ir.actions.act_window">
        <field name="name">Print to Konica</field>
        <field name="res_model">ufs.print.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" eval="False"/>
    </record>
</odoo>
