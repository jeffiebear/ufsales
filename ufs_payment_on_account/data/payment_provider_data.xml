<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!--
        The Pay-on-Account provider. Created disabled + unpublished; the
        admin enables it, sets its payment journal, and publishes it once
        (env-specific config a data file can't set reliably).

        - code='custom' + custom_mode='pay_on_account' satisfies the
          payment_custom SQL constraint and routes through the generic
          custom transaction flow, which leaves the transaction pending.
          The order is confirmed by our own _post_process override in
          models/payment_transaction.py, because stock Odoo confirms
          only on an authorized or done transaction.
        - redirect_form_view_id reuses payment_custom's generic redirect
          form (posts the reference to /payment/custom/process).
        - ufs_requires_payment_terms (from ufs_wholesale) gates it to
          net-terms customers at checkout.
    -->
    <record id="payment_provider_ufs_on_account" model="payment.provider">
        <field name="name">Pay on Account (Net Terms)</field>
        <field name="code">custom</field>
        <field name="custom_mode">pay_on_account</field>
        <field name="company_id" ref="base.main_company"/>
        <field name="state">disabled</field>
        <field name="is_published" eval="False"/>
        <field name="ufs_requires_payment_terms" eval="True"/>
        <field name="redirect_form_view_id" ref="payment_custom.redirect_form"/>
        <field name="payment_method_ids"
               eval="[Command.set([ref('ufs_payment_on_account.payment_method_pay_on_account')])]"/>
        <field name="pending_msg" type="html">
            <div>
                <p>Thank you — your order is confirmed.</p>
                <p>You will be invoiced according to your account's payment
                   terms. No online payment is required.</p>
            </div>
        </field>
    </record>

</odoo>
