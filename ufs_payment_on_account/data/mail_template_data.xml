<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Re-point the order confirmation subject at the order's own state.

        This has to be a <function> rather than a <record>. The template
        belongs to sale and is declared noupdate, and that flag sits on the
        record's ir.model.data row, so a <record> targeting the same xml id
        from this module is skipped on every upgrade. A function call is
        plain Python run by the data loader, which is not subject to the
        flag, and data files re-run on each module update so the fix is
        restored if the template is ever reset.

        See models/mail_template.py for why the subject is wrong in the
        first place and why only one condition is rewritten.
    -->
    <function model="mail.template"
              name="_ufs_fix_order_confirmation_subject"/>

</odoo>
